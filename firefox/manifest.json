{
  "manifest_version": 3,
  "name": "HydraFreecker",
  "version": "1.1.0",
  "description": "Remplace la résolution Hydracker par l'API Movix.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{f5e8d2a0-1b3c-4e6f-9a7b-2c4d5e8f1a3b}",
      "strict_min_version": "128.0"
    }
  },
  "permissions": ["declarativeNetRequest", "declarativeNetRequestWithHostAccess", "storage"],
  "host_permissions": [
    "https://hydracker.com/*",
    "https://movix.online/*",
    "https://*.movix.online/*",
    "https://*.movix.date/*",
    "https://*.movix.chat/*",
    "https://*.movix.golf/*",
    "https://*.movix.cloud/*",
    "https://*.movix.cash/*",
    "https://*.movix.tax/*",
    "https://*.movix.health/*",
    "https://*.movix.help/*",
    "https://*.movix.llc/*",
    "https://*.movix.rodeo/*",
    "https://*.movix.blog/*",
    "https://*.movix.club/*",
    "https://*.movix.website/*",
    "https://*.movix.site/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "HydraFreecker — Tableau de bord",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://hydracker.com/*"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://hydracker.com/*"],
      "js": ["stats.js", "menu-ui.js", "content.js"],
      "css": ["modal.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
