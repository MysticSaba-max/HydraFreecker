{
  "manifest_version": 3,
  "name": "HydraFreecker",
  "version": "1.0.0",
  "description": "Remplace le débridage Hydracker par l'API Movix.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["declarativeNetRequest"],
  "host_permissions": [
    "https://hydracker.com/*",
    "https://api.movix.tax/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://hydracker.com/*"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://hydracker.com/*"],
      "js": ["content.js"],
      "css": ["modal.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
